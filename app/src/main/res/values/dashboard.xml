<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Single source of truth for the dashboard, including legacy screen aliases. -->
    <color name="dashboard_background">#0E1015</color>
    <color name="dashboard_surface">#13161D</color>
    <color name="dashboard_card">#181C24</color>
    <color name="dashboard_pressed">#1D222C</color>
    <color name="dashboard_primary">#8B5CF6</color>
    <color name="dashboard_primary_bright">#9D74FF</color>
    <color name="dashboard_primary_dark">#6D43D6</color>
    <color name="dashboard_text">#F5F7FA</color>
    <color name="dashboard_text_secondary">#9299A6</color>
    <color name="dashboard_border">#12FFFFFF</color>
    <color name="dashboard_success">#4ADE80</color>
    <color name="dashboard_warning">#FBBF24</color>
    <color name="dashboard_error">#EF5350</color>
    <color name="dashboard_light_background">#F5F5FA</color>
    <color name="dashboard_light_surface">#FFFFFF</color>
    <color name="dashboard_light_card">#FFFFFF</color>
    <color name="dashboard_light_text">#202330</color>
    <color name="dashboard_light_secondary">#656D7C</color>
    <color name="dashboard_light_border">#14202330</color>
    <dimen name="dashboard_radius">14dp</dimen>
    <dimen name="dashboard_spacing">12dp</dimen>
    <dimen name="dashboard_padding">16dp</dimen>
    <dimen name="dashboard_touch_target">48dp</dimen>
    <dimen name="dashboard_body">15sp</dimen>
    <dimen name="dashboard_caption">13sp</dimen>
    <style name="DashboardCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/dashboard_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="DashboardButton" parent="Widget.AppCompat.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>
    <style name="DashboardBottomItem" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/dashboard_nav_item</item>
        <item name="android:textColor">@android:color/transparent</item>
        <item name="android:textSize">1sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:drawableTint">@color/dashboard_text</item>
    </style>
    <style name="DashboardBottomImageItem" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/dashboard_nav_item</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="DashboardTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
    <style name="DashboardTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="DashboardBody" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/dashboard_body</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="DashboardCaption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/dashboard_caption</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
